# ==============================================================================
# Performax Environment Variables Template (.env.example)
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# NOTE: Never commit your actual .env file or production secrets to Git!
# ==============================================================================

# Database Configuration (Used by PostgreSQL container & Django backend)
POSTGRES_DB=intern_pms_db
POSTGRES_USER=intern_pms_user
POSTGRES_PASSWORD=intern_pms_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Application Settings
DJANGO_SECRET_KEY=django-insecure-performax-dev-secret-key-12345
DJANGO_DEBUG=True
USE_SQLITE=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend API Endpoint
VITE_API_BASE_URL=/api

# Optional: Email Delivery (for Real OTP Delivery to @dailoqa.com)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
RESEND_API_KEY=
